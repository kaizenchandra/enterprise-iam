# Copy to .env.local. Use the same issuer that appears in IAM discovery.
IAM_ISSUER=http://localhost:9000
CONSOLE_ORIGIN=http://localhost:3000
CONSOLE_REDIS_URL=redis://localhost:6379
CONSOLE_REDIS_PREFIX=iam:next-console:
# Must match a registered confidential Code+PKCE client (local bootstrap provisions this client).
CONSOLE_CLIENT_ID=next-console
CONSOLE_CLIENT_SECRET=replace-with-PORTAL_SECRET-from-root-env
# Only for loopback HTTP development. Production requires HTTPS and true.
CONSOLE_COOKIE_SECURE=false
RESOURCE_ORIGIN=http://localhost:9001
# Optional explicit connection alias when using the Compose issuer from a host-run frontend.
# IAM_ISSUER remains the exact expected JWT issuer; this only changes transport URLs.
# IAM_ISSUER=http://iam.localhost:9000
# IAM_TRANSPORT_ORIGIN=http://127.0.0.1:9000
# RESOURCE_ORIGIN=http://127.0.0.1:9001

# Identity pages share the IAM RP hostname (port differs from the backend).
# IAM_AUTH_UI_ORIGIN=http://iam.localhost:3000
