        "required": true,
        "location": "body"
      },
      {
        "name": "clientAuthenticationMethod",
        "type": "string",
        "required": false,
        "location": "body",
        "enum": [
          "client_secret_basic",
          "private_key_jwt"
        ]
      },
      {
        "name": "jwks",
        "type": "object",
        "required": false,
        "location": "body"
      }
    ],
